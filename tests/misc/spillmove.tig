let
  function id(x: int): int = x
  var a0 := id(0)
  var a1 := id(1)
  var a2 := id(2)
  var a3 := id(3)
  var a4 := id(4)
  var a5 := id(5)
  var a6 := id(6)
  var a7 := id(7)
  var a8 := id(8)
  var a9 := id(9)
  var a10 := id(10)
  var a11 := id(11)
  var a12 := id(12)
  var a13 := id(13)
  var a14 := id(14)
  var a15 := id(15)
  var a16 := id(16)
  var a17 := id(17)
  var a18 := id(18)
  var a19 := id(19)
in
  print(chr(ord("a") + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 - 190));
  a1 := a2;
  a3 := a4;
  print(chr(ord("a") + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 - 190));
  print(chr(ord("a") + a1)); print(chr(ord("a") + a3)); print("\n")
end
