/* all binary expressions supported by Tiger */

(
    /* simple expressions */

    0 + 1;
    0 - 1;
    3 * 2;
    3 / 2;
    0 >= 1;
    0 <= 1;
    0 > 0;
    1 < 2;
    0 & 1;
    0 | 1;
    
    /* only +, -, *, /, &, | can be chained */

    0 + 1 - 2 / 2;
    0 + 1 * 3 / 2 * (3 - 2);

    0 & 1 & 2 | 2;
    2 | 3 | 4 & 1
)
