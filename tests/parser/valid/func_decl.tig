/* some function declarations */

let 
    /* recursive functions */
    function is_even(n: int): int = if n = 0 then 1 else is_odd(n - 1)
    function is_odd(n: int): int = if n = 0 then 0 else is_even(n - 1)
    
    /* procedure */
    function f() = print("is_even: ")

    /* three params */
    function g(a: int, b: int, c: string) = 0
    
  in
    f(); print(is_even(6))
end